{
  "name": "elyoxe",
  "domain": "mrdmx7.github.io",
  "base_url": "https://mrdmx7.github.io/elyoxe",
  "lang": "en",
  "dir": "ltr",
  "_comment_src_out": "src_dir != out_dir here, unlike invoiceready. src/ holds hand-authored assets, dist/ is pure build output, so deploy-site.sh may clean it before every build.",
  "src_dir": "src",
  "out_dir": "dist",
  "generate": [
    "python3 build/generate.py"
  ],
  "min_html_count": 9,
  "aws": {
    "region": "ap-south-1",
    "bucket": "elyoxe-574771023173",
    "distribution_id": "",
    "zone_id": ""
  },
  "verify": [
    {
      "path": "/",
      "contains": "Elyoxe"
    },
    {
      "path": "/ar/",
      "contains": "dir=\"rtl\""
    },
    {
      "path": "/work/invoiceready.html",
      "contains": "102"
    },
    {
      "path": "/work/khutwa.html",
      "contains": "Khutwa"
    },
    {
      "path": "/work/quantitative-method.html",
      "contains": "falsified"
    },
    {
      "path": "/ar/work/invoiceready.html",
      "contains": "غير معلن"
    },
    {
      "path": "/sitemap.xml",
      "contains": "<urlset"
    },
    {
      "path": "/robots.txt",
      "contains": "Sitemap"
    }
  ],
  "_comment_domain": "Temporary: GitHub Pages until elyoxe.com is registered (external registrar, planned Oct 2026). Then set domain=elyoxe.com, base_url=https://elyoxe.com and run new-site.sh elyoxe.com elyoxe --existing-domain."
}
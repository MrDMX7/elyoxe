{
  "name": "elyoxe-site",
  "private": true,
  "version": "2.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/gen-ubl-samples.mjs && next build && node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit",
    "check:ubl": "node scripts/check-ubl-sync.mjs",
    "gen:ubl": "node scripts/gen-ubl-samples.mjs",
    "lint:rtl": "stylelint \"app/**/*.css\" \"components/**/*.css\"",
    "test": "vitest run",
    "lint:dead": "knip --no-progress",
    "svg": "svgr --typescript --no-dimensions --out-dir components/icons --"
  },
  "dependencies": {
    "@lottiefiles/dotlottie-react": "^0.19.16",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.1.0",
    "@react-three/postprocessing": "^3.1.1",
    "gsap": "^3.13.0",
    "lenis": "^1.3.0",
    "lygia": "^1.4.1",
    "motion": "^13.4.0",
    "next": "^15.3.0",
    "opentype.js": "^2.0.0",
    "postprocessing": "^6.39.5",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "three": "^0.176.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@next/bundle-analyzer": "^16.3.5",
    "@svgr/cli": "^8.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.176.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fontaine": "^0.8.2",
    "jsdom": "^30.1.0",
    "knip": "^6.37.0",
    "playwright": "^1.63.0",
    "postcss-logical": "^8.1.0",
    "react-scan": "^0.5.7",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-plugin-logical-css": "^1.3.0",
    "typescript": "^5.8.0",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "skia-canvas@3.0.8": true
  }
}
